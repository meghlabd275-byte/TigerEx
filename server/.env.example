# TigerEx Configuration
# Copy this to .env and fill in actual values

# Server
PORT=8080
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tigerex?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tigerex
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=tigerex-jwt-secret-change-in-production-minimum-32-chars!

# External APIs (optional - for 2FA, KYC, etc.)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# JUMIO_API_KEY=
# JUMIO_API_SECRET=
# STRIPE_SECRET_KEY=
# PLAID_CLIENT_ID=
# PLAID_SECRET=

# Blockchain RPC (for wallet integration)
# ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY
# BTC_RPC_URL=https://blockstream.info/api/

# Logging
LOG_LEVEL=info