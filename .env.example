# =============================================================================
# TIGEREX ENVIRONMENT CONFIGURATION
# =============================================================================
# DO NOT COMMIT ACTUAL SECRETS TO VERSION CONTROL
# Copy this file to .env and fill in your actual values

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=development
PORT=3000
API_PORT=8080
APP_URL=http://localhost:3000
APP_NAME=TigerEx

# =============================================================================
# DATABASE - PostgreSQL
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tigerex
DB_USER=tigerex
DB_PASSWORD=your-secure-password
DB_MAX_CONNS=100
DB_MIN_CONNS=10
DB_MAX_CONN_LIFETIME=30m
DB_HEALTH_CHECK=1m
DATABASE_URL=postgresql://tigerex:your-secure-password@localhost:5432/tigerex?sslmode=require

# =============================================================================
# REDIS CACHE
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# =============================================================================
# KAFKA MESSAGE QUEUE (Optional)
# =============================================================================
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_PREFIX=tigerex

# =============================================================================
# JWT & SESSIONS
# =============================================================================
JWT_SECRET=your-256-bit-secret-key-change-in-production
JWT_REFRESH_SECRET=your-256-bit-refresh-secret-key
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# =============================================================================
# SECURITY
# =============================================================================
BCRYPT_COST=12
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15m
SESSION_DURATION=24h

# =============================================================================
# BLOCKCHAIN NODES (TigerEx Independent - No Exchange Dependencies)
# =============================================================================
BTC_NODE_URL=https://bitcoin-node.example.com:8332
BTC_NODE_USER=
BTC_NODE_PASSWORD=
ETH_NODE_URL=https://ethereum-node.example.com:8545
ETH_NODE_WS_URL=wss://ethereum-node.example.com:8546
ETH_NODE_API_KEY=

# =============================================================================
# TRADING ENGINE
# =============================================================================
ORDER_MATCHING_MODE=memory
ORDER_BOOK_DEPTH=100
MAX_ORDERS_PER_USER=1000
MAX_POSITIONS_PER_USER=100
DEFAULT_TRADING_FEE=0.001
MAKER_FEE=0.001
TAKER_FEE=0.001

# =============================================================================
# TRADING PAIRS (14 Initial Pairs)
# =============================================================================
TRADING_PAIRS=BTC/USDT,ETH/USDT,BNB/USDT,SOL/USDT,XRP/USDT,ADA/USDT,DOGE/USDT,DOT/USDT,MATIC/USDT,LTC/USDT,AVAX/USDT,LINK/USDT,ATOM/USDT,UNI/USDT

# =============================================================================
# KYC PROVIDERS (Future Integration)
# =============================================================================
JUMIO_API_KEY=
JUMIO_API_SECRET=
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
CHAINALYSIS_API_KEY=

# =============================================================================
# PAYMENT GATEWAYS
# =============================================================================
STRIPE_API_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# SEPA Banking
SEPA_BANK_NAME=
SEPA_IBAN=
SEPA_BIC=

# SWIFT Banking
SWIFT_BANK_NAME=
SWIFT_IBAN=
SWIFT_BIC=
SWIFT_ROUTING_NUMBER=

# =============================================================================
# EXTERNAL SERVICES (Monitoring, Analytics)
# =============================================================================
SENTRY_DSN=
DATADOG_API_KEY=
LOG_LEVEL=debug
LOG_FORMAT=json

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_SPOT_TRADING=true
ENABLE_FUTURES=false
ENABLE_OPTIONS=false
ENABLE_MARGIN=false
ENABLE_P2P=true
ENABLE_EARN=true
ENABLE_STAKING=true
ENABLE_COPY_TRADING=true
ENABLE_TRADING_BOTS=true

# =============================================================================
# REGIONAL SETTINGS
# =============================================================================
DEFAULT_LOCALE=en
DEFAULT_TIMEZONE=UTC
DEFAULT_COUNTRY=US
SUPPORTED_LOCALES=en,es,zh,ja,ko,ar,ru,pt,fr,de
SUPPORTED_COUNTRIES=US,GB,EU,AU,CA,JP,KR,SG,AE